app_name=epusdt
app_uri=https://epusdt.com
log_level=info
http_access_log=false
sql_debug=false
http_listen=:8000

static_path=/static
runtime_root_path=./runtime

log_save_path=./logs
log_max_size=32
log_max_age=7
max_backups=3

# supported values: postgres,mysql,sqlite
db_type=sqlite

# sqlite primary database config
sqlite_database_filename=
sqlite_table_prefix=


# sqlite runtime store config
runtime_sqlite_filename=epusdt-runtime.db

# background scheduler config
queue_concurrency=10
queue_poll_interval_ms=1000
callback_retry_base_seconds=5

order_expiration_time=10
order_notice_max_retry=0

api_rate_url=

# API Key Secret master keyring. Required for merchant HMAC secrets.
# Each key is 32 bytes encoded as 64 hexadecimal characters.
# Keep this file outside the database, image, and source repository.
# Generate with: openssl rand -hex 32
# Overlapping rotation: set a new active key, put old keys in decrypt_keys as id=hex,id=hex,
# reencrypt, then remove unused old keys after pending orders have drained.
api_key_secret_active_key_id=
api_key_secret_active_key=
api_key_secret_decrypt_keys=

# Set to true to re-run the install wizard on next startup.
install=true
